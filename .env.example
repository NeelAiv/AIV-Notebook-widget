# Copy this file to .env and fill in your values
# The app can also be configured via the Settings UI after startup

# Optional: set your OpenAI key here instead of through the UI
OPENAI_API_KEY=

# RAG vector store (PostgreSQL + pgvector). Required for semantic / RAG features.
# Docker Compose sets this automatically for the app container.
RAG_DATABASE_URL=postgresql://rag:ragsecret@127.0.0.1:5432/rag

# Optional: override Postgres password used by Compose (must match RAG_DATABASE_URL)
# RAG_POSTGRES_PASSWORD=ragsecret

# Local sentence-transformers model for embeddings (offline). Default is BGE-base (768 dims).
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Optional: fix vector column size if it must differ from the model output (advanced).
# If unset, the app uses the model's native embedding size.
# EMBEDDING_DIMENSION=768
